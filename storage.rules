rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Clinic invoice PDFs — authenticated read/write
    match /clinics/{clinicId}/invoices/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Clinic prescription PDFs — authenticated read/write
    match /clinics/{clinicId}/prescriptions/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Clinic documents — authenticated read/write
    match /clinics/{clinicId}/documents/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Clinic logos and assets — authenticated read/write
    match /clinics/{clinicId}/assets/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

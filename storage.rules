rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ─── Clinic Documents Storage Rules ───
    match /clinics/{clinicId}/{allPaths=**} {
      allow read: if true; // Allow read for document retrieval
      allow write: if request.auth != null; // Authenticated clinic staff only
    }

    // ─── Prescriptions: Public read, Admin upload (Legacy backward compatibility) ───
    match /prescriptions/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}


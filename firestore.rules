rules_version = '2';

// =============================================================================
// SANJIVANI DENTALS - FIRESTORE SECURITY RULES
// Healthcare Operations & Data Access Model
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // CENTRAL AUTHENTICATION HELPER
    // =========================================================================

    /** Checks whether the incoming request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // =========================================================================
    // PATIENT & CLINICAL DATA COLLECTIONS
    // =========================================================================

    // Patient Directory Records
    match /patients/{patientId} {
      allow read, write: if isSignedIn();
    }

    // Comprehensive Patient Medical Histories & Profiles
    match /patientMedicalProfiles/{profileId} {
      allow read, write: if isSignedIn();
    }

    // Patient Clinical Encounters & Dental Chartings
    match /patientEncounters/{encounterId} {
      allow read, write: if isSignedIn();
    }

    // Legacy Encounters collection compatibility
    match /encounters/{encounterId} {
      allow read, write: if isSignedIn();
    }

    // Active Prescriptions
    match /prescriptions/{prescriptionId} {
      allow read, write: if isSignedIn();
    }

    // Archived Prescriptions
    match /archived_prescriptions/{prescriptionId} {
      allow read, write: if isSignedIn();
    }

    // =========================================================================
    // APPOINTMENTS, DOCTORS & SERVICES
    // =========================================================================

    // Clinic Appointments (Allows public website bookings and staff management)
    match /appointments/{appointmentId} {
      allow read, update, delete: if isSignedIn();
      allow create: if true; // Allows public online appointment bookings from landing page
    }

    // Archived Appointments
    match /archived_appointments/{appointmentId} {
      allow read, write: if isSignedIn();
    }

    // In-App Notifications
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    // Archived Notifications
    match /archived_notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    // Doctors & Clinical Specialists Directory (Public read for landing page)
    match /doctors/{doctorId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Dental Treatment Catalog & Procedure Services (Public read for landing page)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // =========================================================================
    // FINANCIAL, BILLING & EXPENSE MANAGEMENT
    // =========================================================================

    // Treatment Invoices & Payment Tracking
    match /invoices/{invoiceId} {
      allow read, write: if isSignedIn();
    }

    // Clinic Operating Expenses
    match /expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }

    // Patient & Doctor Referrals Tracking
    match /clinicReferrals/{referralId} {
      allow read, write: if isSignedIn();
    }

    // Referral Program Configuration
    match /clinicReferralConfig/{configId} {
      allow read, write: if isSignedIn();
    }

    // Clinic Subscription & Tier Metadata
    match /subscriptionInfo/{subId} {
      allow read, write: if isSignedIn();
    }

    // =========================================================================
    // ADMINISTRATIVE, TEAM & SYSTEM SETTINGS
    // =========================================================================

    // Basic Clinic Profile & Header Information (Public read for landing page header/contact)
    match /clinicSettings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Clinic Resources & Dental Chairs
    match /clinicResources/{docId} {
      allow read, write: if isSignedIn();
    }

    // Calendar & Appointment Slot Configuration (Public read for booking slots)
    match /appointmentSettings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Invoicing & Tax Settings
    match /billingSettings/{docId} {
      allow read, write: if isSignedIn();
    }

    // Security & Inactivity Timeout Configuration
    match /securitySettings/{docId} {
      allow read, write: if isSignedIn();
    }

    // Clinic Staff & Team Directory
    match /teamMembers/{memberId} {
      allow read, write: if isSignedIn();
    }

    // RBAC Custom Roles & Permission Definitions
    match /roles/{roleId} {
      allow read, write: if isSignedIn();
    }

    // =========================================================================
    // SYSTEM LOGS, SESSIONS & MESSAGING (PROTECTED)
    // =========================================================================

    // User Login & Logout History Logs (Deletion Denied)
    match /loginHistory/{entryId} {
      allow read, create, update: if isSignedIn();
      allow delete: if false;
    }

    // Immutable Security Audit Logs (Append-Only; Update & Delete Denied)
    match /auditLogs/{logId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }

    // Active User Sessions & Activity Monitors
    match /securitySessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    // Monthly WhatsApp Messaging Quotas (Deletion Denied)
    match /messagingUsage/{quotaId} {
      allow read, create, update: if isSignedIn();
      allow delete: if false;
    }

    // WhatsApp Message Delivery Logs & Status Callbacks (Deletion Denied)
    match /messageLogs/{logId} {
      allow read, create, update: if isSignedIn();
      allow delete: if false;
    }

    // Central Document Storage Metadata Records
    match /documents/{documentId} {
      allow read, write: if isSignedIn();
    }

    // Dental X-rays & Diagnostic Imaging
    match /xrays/{xrayId} {
      allow read, write: if isSignedIn();
    }

    // =========================================================================
    // GLOBAL DEFAULT DENY FALLBACK
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}